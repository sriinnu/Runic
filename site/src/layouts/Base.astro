---
import '../styles/site.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; description?: string; path?: string; fullBleed?: boolean }
const { title, description = 'AI usage, costs and quota resets in your Mac menu bar.', path = '/', fullBleed = false } = Astro.props;
const full = title ? `${title} · Runic` : 'Runic — AI usage in your menu bar';
const nav = [
  ['/themes-and-skins/', 'Themes'],
  ['/providers/', 'Providers'],
  ['/claude/', 'Claude'],
  ['/cli/', 'CLI'],
  ['/mcp/', 'MCP'],
  ['/architecture/', 'Architecture'],
  ['/contributing/', 'Contribute'],
];
const canonical = new URL(path, 'https://runic.srinivas.dev').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/runic-icon.png" />
    <link rel="apple-touch-icon" href="/runic-icon.png" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="dark light" />
    <ClientRouter />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><img src="/runic-icon.png" width="28" height="28" alt="" /><span>Runic</span></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="gh" href="https://github.com/sriinnu/Runic">GitHub</a>
    </header>
    <main class:list={{ bleed: fullBleed }}><slot /></main>
    <footer class="site-foot">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="brand" href="/"><img src="/runic-icon.png" width="32" height="32" alt="" /><span>Runic</span></a>
          <p>AI usage, costs and quota resets in your Mac menu bar. Local, private, open source.</p>
        </div>
        <nav aria-label="Docs">
          <h2>Docs</h2>
          <a href="/themes-and-skins/">Themes and skins</a>
          <a href="/providers/">Providers</a>
          <a href="/claude/">Claude</a>
          <a href="/cli/">CLI</a>
          <a href="/mcp/">MCP</a>
        </nav>
        <nav aria-label="Build">
          <h2>Build</h2>
          <a href="/architecture/">Architecture</a>
          <a href="/contributing/">Contributing</a>
          <a href="/release-and-ops/">Release and ops</a>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <a href="https://github.com/sriinnu/Runic">GitHub</a>
          <a href="https://github.com/sriinnu/Runic/releases">Releases</a>
          <a href="https://github.com/sriinnu/Runic/wiki">Wiki</a>
          <a href="https://github.com/sriinnu/Runic/issues">Issues</a>
        </nav>
      </div>
      <p class="foot-base"><span>Open source under the <a href="https://github.com/sriinnu/Runic/blob/main/LICENSE">MPL-2.0</a>. Bundled libraries and fonts keep their own licenses: <a href="https://github.com/sriinnu/Runic/blob/main/THIRD-PARTY-NOTICES.md">third-party notices</a>.</span><span>Needs macOS 14 or later</span></p>
    </footer>
  </body>
</html>
