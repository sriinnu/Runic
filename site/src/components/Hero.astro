---
// One hero per subpage. Each page has its own signature visual so the docs
// don't read as one template; the markdown body below is the wiki content.
interface Props { slug: string }
const { slug } = Astro.props;
const themes = [
  ['theme-gazette.jpg', 'Gazette', 'Fraunces · Manrope', '#b8860b'],
  ['theme-sumi.jpg', 'Sumi', 'Shippori Mincho', '#c93a1e'],
  ['theme-drafting.jpg', 'Blueprint', 'Geist Mono', '#7fd3ff'],
  ['theme-instrument.jpg', 'Retro', 'Archivo Narrow', '#b23a24'],
  ['theme-departures.jpg', 'Departures', 'Barlow Condensed', '#f2c94c'],
  ['theme-flightdeck.jpg', 'Flight deck', 'B612', '#4fe3c1'],
  ['theme-receipt.jpg', 'Receipt', 'Courier Prime', '#ff5160'],
];
const stages = ['Preflight', 'Gates', 'Notarize', 'Tag & publish', 'Appcast', 'Homebrew'];
const steps = ['build', 'test', 'render', 'read the glyphs', 'PR'];
---
{slug === 'themes-and-skins' && (
  <div class="hero-rack">
    <p class="kicker">Seven kits</p>
    <div class="rack">
      {themes.map(([img, name, face, color]) => (
        <figure style={`--c:${color}`}>
          <img src={`/images/${img}`} alt={`${name} theme`} loading="lazy" />
          <figcaption><b>{name}</b><span>{face}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
)}

{slug === 'providers' && (
  <div class="hero-chain">
    <p class="kicker">Strategies run in order · the first to answer wins</p>
    <div class="chain">
      <span>OAuth</span><i>→</i><span>Web session</span><i>→</i><span>CLI</span><i>→</i><span>Local logs</span>
    </div>
    <p class="chain-note">Claude, Codex, Gemini, Cursor, Copilot, DeepSeek, Kimi, z.ai, Qwen, Cline, Ollama Cloud and more.</p>
  </div>
)}

{slug === 'claude' && (
  <div class="hero-card">
    <div class="mock" role="img" aria-label="A Claude card showing session, weekly, usage credits and API credits">
      <div class="m-head"><b>Claude</b><span class="pill">Max 20x</span></div>
      <div class="m-row"><span>Session</span><span>62% used</span></div>
      <div class="m-bar"><i style="width:62%"></i></div>
      <div class="m-row"><span>Weekly</span><span>20% used</span></div>
      <div class="m-bar"><i style="width:20%"></i></div>
      <div class="m-sec">Usage credits</div>
      <div class="m-line">This month: $4.50 / $10.00 · Balance $12.50</div>
      <div class="m-line new">API credits $200.00 a month · next grant Nov 3</div>
    </div>
    <ul class="callouts">
      <li><b>Session, weekly</b>from your Claude login</li>
      <li><b>Usage credits</b>pay-as-you-go past the plan</li>
      <li class="hot"><b>API credits</b>shown only when the plan includes one</li>
    </ul>
  </div>
)}

{slug === 'cli' && (
  <div class="hero-term">
    <div class="term" role="img" aria-label="Terminal showing runic commands">
      <div class="dots"><i></i><i></i><i></i></div>
<pre><code><span class="p">$</span> runic --provider claude
<span class="p">$</span> runic --provider all --format json --pretty
<span class="p">$</span> runic cost
<span class="p">$</span> runic insights
<span class="p">$</span> runic otel-collect</code></pre>
    </div>
  </div>
)}

{slug === 'mcp' && (
  <div class="hero-wire">
    <div class="wire">
      <div class="node">Claude Code<br /><small>Codex · Cursor · any MCP client</small></div>
      <div class="link"><span>stdio</span></div>
      <div class="node hot">runic mcp serve<br /><small>runic_limits · runic_health</small></div>
      <div class="link"><span>local</span></div>
      <div class="node">Your providers<br /><small>read-only, on your Mac</small></div>
    </div>
  </div>
)}

{slug === 'architecture' && (
  <div class="hero-flow">
    <div class="flow">
      <div class="col"><span>Providers</span><small>OAuth · web · CLI · logs · OTLP</small></div>
      <i>→</i>
      <div class="col"><span>RunicCore</span><small>fetch · parse · ledger</small></div>
      <i>→</i>
      <div class="col hot"><span>UsageStore</span><small>state · cadence</small></div>
      <i>→</i>
      <div class="col"><span>Surfaces</span><small>menu · icon · widget · CLI</small></div>
    </div>
  </div>
)}

{slug === 'contributing' && (
  <div class="hero-steps">
    <ol>
      {steps.map((s, n) => <li><b>{n + 1}</b>{s}</li>)}
    </ol>
  </div>
)}

{slug === 'release-and-ops' && (
  <div class="hero-pipe">
    <div class="pipe">
      {stages.map((s, n) => <div class="stage"><b>{n + 1}</b>{s}</div>)}
    </div>
  </div>
)}
