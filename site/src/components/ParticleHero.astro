---
// A river of light: thousands of particles stream along the Runic lemniscate,
// drawn as a true figure-eight in 3D. Particles on the "used" share of the loop
// burn bright, the rest stay dim; a hot head marks the current level. The
// pointer orbits the figure, depth blurs the sprites, scroll breathes the scale.
interface Props { accent?: string; accent2?: string; compact?: boolean }
const { accent = '#3ff0d6', accent2 = '#4a63ff', compact = false } = Astro.props;
---
<div class:list={['particles', { compact }]} data-accent={accent} data-accent2={accent2} data-compact={compact ? '1' : '0'} style={`--a:${accent}`}>
  <canvas aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>
  <div class="content"><slot /></div>
</div>

<style>
  .particles { position: relative; overflow: hidden; isolation: isolate; color: #eef3fb; min-height: 640px;
    background: radial-gradient(900px 560px at 72% 46%, rgba(45,91,255,.22), transparent 70%),
                radial-gradient(700px 480px at 20% 10%, rgba(63,240,214,.10), transparent 70%), #05080d; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: -2; }
  .veil { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgba(5,8,13,.78) 0%, rgba(5,8,13,.45) 38%, rgba(5,8,13,0) 62%),
                linear-gradient(180deg, rgba(5,8,13,0) 70%, var(--bg, #070b12)); }
  .content { position: relative; max-width: 1180px; margin: 0 auto; padding: 96px 28px 88px; }
  .compact { min-height: 300px; background: radial-gradient(700px 360px at 78% 50%, color-mix(in srgb, var(--a) 22%, transparent), transparent 70%), #05080d; }
  .compact .content { padding: 64px 28px 56px; }
  @media (max-width: 820px) { .veil { background: linear-gradient(180deg, rgba(5,8,13,.55), rgba(5,8,13,.8)); } }
</style>

<script>
  const VERT = `
attribute vec4 aSeed; attribute vec3 aRand;
uniform float uTime, uAspect, uFill, uYaw, uPitch, uScale, uPx;
uniform vec2 uCenter; uniform vec3 uA, uB;
varying vec3 vC; varying float vA;
vec3 curve(float s){ float u=6.2831853*s; float d=1.+sin(u)*sin(u);
  return vec3(cos(u)/d, sin(u)*cos(u)/d, .52*sin(u)); }
void main(){
  bool dust = aRand.z > .90;
  vec3 p; float hot=0., head=0., depth;
  if(dust){
    p = vec3(fract(aSeed.x*7.31)*5.-2.5, fract(aSeed.z*3.17)*3.-1.5, fract(aSeed.w*5.73)*3.-1.5);
    p.x += .02*sin(uTime*.2+aSeed.x*40.);
    vC = mix(uB, vec3(1.), .35); vA = .12 + .22*aRand.y;
  } else {
    float s = fract(aSeed.x + uTime*aSeed.y*.045);
    p = curve(s);
    vec3 T = normalize(curve(s+.002)-p);
    vec3 N = normalize(cross(T, vec3(0.,0.,1.))); vec3 B = cross(T, N);
    float a = aSeed.z + uTime*.7*(aRand.x-.5) + s*12.566;
    float r = aSeed.w*(.050+.024*sin(uTime*.5+s*22.));
    p += (N*cos(a)+B*sin(a))*r;
    hot = smoothstep(uFill+.015, uFill-.015, s);
    head = exp(-pow((s-uFill)*26., 2.));
    vC = mix(uB*.9, mix(uA, vec3(1.), .25), hot) + vec3(1.)*head*.7;
    vA = (.20 + .62*hot + 1.0*head) * (.45 + .55*aRand.y) * .20;
  }
  p *= uScale*1.3;
  float cy=cos(uYaw), sy=sin(uYaw); p = vec3(cy*p.x+sy*p.z, p.y, -sy*p.x+cy*p.z);
  float cp=cos(uPitch), sp=sin(uPitch); p = vec3(p.x, cp*p.y-sp*p.z, sp*p.y+cp*p.z);
  float cam = 3.4; depth = cam - p.z; float k = cam/depth;
  vec2 scr = p.xy*k;
  gl_Position = vec4(scr.x/uAspect + uCenter.x, scr.y + uCenter.y, 0., 1.);
  float blur = 1. + 1.8*abs(p.z);
  gl_PointSize = uPx*(1.+aRand.y*2.4)*k*blur*(dust?.55:1.);
  vA /= blur;
}`;
  const FRAG = `
precision mediump float;
varying vec3 vC; varying float vA;
void main(){ vec2 d=gl_PointCoord-.5; float r=dot(d,d)*4.; float a=exp(-r*5.2)*vA; gl_FragColor=vec4(vC*a, a); }`;

  const hex = (h: string): [number, number, number] => {
    const n = parseInt(h.replace('#', ''), 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  };

  document.querySelectorAll<HTMLElement>('.particles').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) return;
    const sh = (t: number, src: string) => {
      const s = gl.createShader(t)!; gl.shaderSource(s, src); gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = innerWidth < 820;
    const compact = root.dataset.compact === '1';
    const N = compact ? (small ? 2200 : 4800) : (small ? 5200 : 12000);
    let seed = 1337;
    const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
    const seedData = new Float32Array(N * 4), randData = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      seedData.set([rnd(), 0.55 + rnd() * 0.9, rnd() * 6.2831853, 0.15 + rnd() * 1.0], i * 4);
      randData.set([rnd(), rnd(), rnd()], i * 3);
    }
    const bind = (name: string, data: Float32Array, size: number) => {
      const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, name);
      gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, size, gl.FLOAT, false, 0, 0);
    };
    bind('aSeed', seedData, 4); bind('aRand', randData, 3);

    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uTime = U('uTime'), uAspect = U('uAspect'), uFill = U('uFill'), uYaw = U('uYaw'), uPitch = U('uPitch'),
      uScale = U('uScale'), uPx = U('uPx'), uCenter = U('uCenter');
    gl.uniform3fv(U('uA'), hex(root.dataset.accent || '#3ff0d6'));
    gl.uniform3fv(U('uB'), hex(root.dataset.accent2 || '#4a63ff'));
    gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE);
    gl.clearColor(0.02, 0.03, 0.05, 1);

    const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
    let w = 1, h = 1, tyaw = 0, tpitch = 0, yaw = 0, pitch = 0, visible = true, raf = 0, scrollY = 0;
    const resize = () => {
      const r = root.getBoundingClientRect();
      w = Math.max(2, Math.floor(r.width * dpr)); h = Math.max(2, Math.floor(r.height * dpr));
      canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h);
    };
    resize(); addEventListener('resize', resize);
    root.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      tyaw = ((e.clientX - r.left) / r.width - 0.5) * 1.5;
      tpitch = ((e.clientY - r.top) / r.height - 0.5) * 0.7;
    });
    root.addEventListener('pointerleave', () => { tyaw = 0; tpitch = 0; });
    addEventListener('scroll', () => { scrollY = Math.min(1, scrollY = window.scrollY / 700); }, { passive: true });

    const start = performance.now();
    const frame = (now: number) => {
      const t = reduce ? 9.0 : (now - start) / 1000;
      yaw += (tyaw * 0.75 + 0.30 * Math.sin(t * 0.28) - yaw) * 0.04; pitch += (tpitch - pitch) * 0.05;
      const fill = 0.62 + 0.06 * Math.sin(t * 0.35);
      const wide = w / h > 1.1;
      gl.uniform1f(uTime, t); gl.uniform1f(uAspect, w / h); gl.uniform1f(uFill, fill);
      gl.uniform1f(uYaw, reduce ? 0.28 : yaw); gl.uniform1f(uPitch, reduce ? -0.2 : pitch - 0.12);
      gl.uniform1f(uScale, compact ? (wide ? 0.56 : 0.5) : (wide ? 0.60 : 0.62) * (1 - scrollY * 0.18));
      gl.uniform1f(uPx, 3.1 * dpr * (compact ? 0.78 : h / 900) + 0.9);
      gl.uniform2f(uCenter, compact ? (wide ? 0.52 : 0.0) : (wide ? 0.38 : 0.0), compact ? 0.0 : (wide ? -0.02 : 0.20));
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.POINTS, 0, N);
      if (!reduce && visible) raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
    }).observe(root);
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
    });
    raf = requestAnimationFrame(frame);
  });
</script>
