---
// A departures board of quota resets, in the idiom of the Departures skin.
// Sample data, the same demo seed the app's renders use: Claude's session is
// spent, Codex is at 62%, two banked resets are held. The countdowns run for
// real from page load, and the spent session departs (resets) a little after
// the board comes into view, so you see the moment a window refills.
//
// Without JavaScript it shows the board as rendered here, frozen.
interface Row { id: string; provider: string; window: string; used: number; status: 'OPEN' | 'OUT' | 'HELD'; secs: number; note?: string }
const rows: Row[] = [
  { id: 'cs', provider: 'Claude', window: 'Session', used: 100, status: 'OUT', secs: 38 },
  { id: 'xs', provider: 'Codex', window: 'Session', used: 62, status: 'OPEN', secs: 2 * 3600 + 14 * 60 },
  { id: 'xw', provider: 'Codex', window: 'Weekly', used: 20, status: 'OPEN', secs: 3 * 86400 + 5 * 3600 },
  { id: 'cw', provider: 'Claude', window: 'Weekly', used: 48, status: 'OPEN', secs: 5 * 86400 + 2 * 3600 },
  { id: 'cb', provider: 'Claude', window: 'Banked × 2', used: -1, status: 'HELD', secs: 26 * 86400, note: 'Usable until' },
];
const pad = (n: number) => String(n).padStart(2, '0');
const left = (s: number) => s >= 86400 ? `${Math.floor(s / 86400)}D ${pad(Math.floor((s % 86400) / 3600))}H`
  : s >= 3600 ? `${Math.floor(s / 3600)}H ${pad(Math.floor((s % 3600) / 60))}M` : `${pad(Math.floor(s / 60))}:${pad(s % 60)}`;
const flaps = (text: string, width: number) => [...text.padEnd(width, ' ').slice(0, width)];
---
<figure class="board" data-board aria-labelledby="board-cap">
  <div class="board-head">
    <span class="board-title">Runic · Departures</span>
    <span class="board-clock" data-clock>--:--</span>
  </div>
  <p class="board-next" aria-live="off">
    <span class="lbl">Next</span>
    <span class="flaps big" data-next>{flaps(left(rows[0].secs), 7).map((c) => <span class="flap">{c}</span>)}</span>
    <span class="flaps big hot" data-next-who>{flaps('CLAUDE', 6).map((c) => <span class="flap">{c}</span>)}</span>
  </p>
  <div class="board-table" role="table" aria-label="Sample quota windows and when they reset">
    <div class="row th" role="row">
      <span role="columnheader" class="c-time">Time</span>
      <span role="columnheader">Window</span>
      <span role="columnheader" class="c-left">Remaining</span>
      <span role="columnheader" class="c-status">Status</span>
    </div>
    {rows.map((r) => (
      <div class="row" role="row" data-row={r.id} data-secs={r.secs} data-used={r.used} data-status={r.status}>
        <span role="cell" class="c-time"><span class="flaps" data-time>{flaps('--:--', 5).map((c) => <span class="flap">{c}</span>)}</span></span>
        <span role="cell" class="c-win"><b>{r.provider}</b><small data-sub>{r.window}{r.used >= 0 ? ` · ${r.used}%` : ' · Redeem on claude.ai'}</small></span>
        <span role="cell" class="c-left"><span class="flaps" data-left>{flaps(left(r.secs), 7).map((c) => <span class="flap">{c}</span>)}</span></span>
        <span role="cell" class="c-status"><span class:list={['flaps', 'st', r.status.toLowerCase()]} data-st>{flaps(r.status, 4).map((c) => <span class="flap">{c}</span>)}</span></span>
      </div>
    ))}
  </div>
  <figcaption id="board-cap">Sample board, demo data. The Departures skin draws your own windows this way: every reset is a departure.</figcaption>
</figure>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  const left = (s: number) => s >= 86400 ? `${Math.floor(s / 86400)}D ${pad(Math.floor((s % 86400) / 3600))}H`
    : s >= 3600 ? `${Math.floor(s / 3600)}H ${pad(Math.floor((s % 3600) / 60))}M` : `${pad(Math.floor(s / 60))}:${pad(s % 60)}`;
  const DAYS = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
  const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
  const when = (d: Date, secs: number) => secs < 86400 ? `${pad(d.getHours())}:${pad(d.getMinutes())}`
    : secs < 6 * 86400 ? DAYS[d.getDay()] : `${MONTHS[d.getMonth()]} ${d.getDate()}`;
  const SESSION = 5 * 3600;

  document.querySelectorAll<HTMLElement>('[data-board]').forEach((board) => {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    // Write text into a row of flaps; a flap whose letter changes turns over.
    const set = (el: HTMLElement, text: string) => {
      const cells = [...el.children] as HTMLElement[];
      const chars = [...text.padEnd(cells.length, ' ').slice(0, cells.length)];
      cells.forEach((c, i) => {
        if (c.textContent === chars[i]) return;
        c.textContent = chars[i];
        if (still.matches) return;
        c.classList.remove('turn');
        void c.offsetWidth;
        c.style.animationDelay = `${i * 35}ms`;
        c.classList.add('turn');
      });
    };
    const rows = [...board.querySelectorAll<HTMLElement>('[data-row]')].map((el) => ({
      el,
      secs: Number(el.dataset.secs),
      used: Number(el.dataset.used),
      status: el.dataset.status!,
      at: 0,
    }));
    const clock = board.querySelector<HTMLElement>('[data-clock]')!;
    const next = board.querySelector<HTMLElement>('[data-next]')!;
    const nextWho = board.querySelector<HTMLElement>('[data-next-who]')!;

    let t0 = 0, started = false, timer = 0;
    const tick = () => {
      const now = Date.now();
      const elapsed = Math.floor((now - t0) / 1000);
      clock.textContent = `${pad(new Date(now).getHours())}:${pad(new Date(now).getMinutes())}`;
      let soonest: { secs: number; who: string } | null = null;
      for (const r of rows) {
        let secs = r.secs - elapsed;
        if (secs <= 0 && r.el.dataset.row === 'cs') {
          // The spent session departs: the window refills and a new one opens.
          r.secs += SESSION; r.used = 0; r.status = 'OPEN';
          r.el.querySelector<HTMLElement>('[data-sub]')!.textContent = 'Session · 0%';
          r.el.classList.add('departed');
          secs = r.secs - elapsed;
        }
        secs = Math.max(0, secs);
        set(r.el.querySelector('[data-left]')!, left(secs));
        set(r.el.querySelector('[data-time]')!, when(new Date(t0 + r.secs * 1000), r.secs));
        const st = r.el.querySelector<HTMLElement>('[data-st]')!;
        if (st.dataset.v !== r.status) {
          st.dataset.v = r.status;
          st.className = `flaps st ${r.status.toLowerCase()}`;
          set(st, r.status);
        }
        if (r.status !== 'HELD' && (!soonest || secs < soonest.secs)) {
          soonest = { secs, who: r.el.querySelector('b')!.textContent!.toUpperCase() };
        }
      }
      if (soonest) { set(next, left(soonest.secs)); set(nextWho, soonest.who); }
      nextWho.classList.toggle('hot', rows[0].status === 'OUT');
    };
    const run = () => {
      clearInterval(timer);
      if (!started || document.hidden) return;
      tick();
      timer = window.setInterval(tick, 1000);
    };
    // The clock starts when the board is first seen, so the departure isn't missed.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !started) { started = true; t0 = Date.now(); run(); }
    }, { threshold: 0.35 }).observe(board);
    document.addEventListener('visibilitychange', run);
  });
</script>
