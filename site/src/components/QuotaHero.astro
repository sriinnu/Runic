---
// The home hero: a dial of quota windows. Each ring is one window, drawn as
// a stream of light; the lit arc is what's used, counted clockwise from
// twelve. As a ring nears its limit it runs hot, then the window resets: a
// flash, and the ring refills from zero. The Runic mark turns at the centre.
// Raw WebGL2, no library.
//
// Hovering fast-forwards the clock towards the next reset. With Reduce Motion
// it draws one still frame; off screen or in a hidden tab it stops. Without
// WebGL2 the CSS dial behind the canvas shows instead.
---
<section class="quota-hero">
  <canvas class="quota-canvas" aria-hidden="true"></canvas>
  <div class="quota-fallback" aria-hidden="true"></div>
  <div class="quota-veil" aria-hidden="true"></div>
  <div class="quota-content"><slot /></div>
</section>

<script>
  const RINGS = 5;
  const VERT = `#version 300 es
  precision highp float;
  in vec3 aP;            // x: kind (0..4 ring, 5 tick, 6 mark) · y, z: seeds
  uniform float uTime, uAspect, uDpr, uScale, uSweep;
  uniform vec2 uCenter;
  uniform float uFill[${RINGS}];
  uniform float uFlash[${RINGS}];
  out vec3 vC;
  out float vA;
  const float TAU = 6.2831853;
  const vec3 TEAL = vec3(0.247, 0.941, 0.839);
  const vec3 BLUE = vec3(0.290, 0.388, 1.0);
  const vec3 HOT  = vec3(1.0, 0.318, 0.376);
  const vec3 AMBER = vec3(0.949, 0.788, 0.298);

  vec2 place(vec2 p) { return vec2(p.x * uScale / uAspect, p.y * uScale) + uCenter; }

  void main() {
    int kind = int(aP.x + 0.5);
    float s = aP.y, s2 = aP.z;
    vec2 p;
    float size;
    if (kind < ${RINGS}) {
      float fi = float(kind);
      float fill = uFill[kind], flash = uFlash[kind];
      // Particles drift round the ring; the arc they sit on decides their light.
      float u = fract(s + uTime * (0.006 + 0.003 * fi) * (mod(fi, 2.0) < 1.0 ? 1.0 : -1.0));
      float th = 1.5707963 - u * TAU;
      float R = 0.36 + fi * 0.125;
      float r = R + (s2 - 0.5) * (0.013 + 0.005 * fi) + flash * 0.06 * s2
              + 0.004 * sin(uTime * 0.9 + s * 60.0);
      p = vec2(cos(th), sin(th)) * r;
      float used = smoothstep(fill + 0.003, fill - 0.003, u);
      float head = exp(-pow((u - fill) * 70.0, 2.0)) * step(0.01, fill);
      float heat = smoothstep(0.70, 0.97, fill);
      vec3 lit = mix(mix(TEAL, BLUE, fi / 6.0), mix(AMBER, HOT, heat), heat);
      vC = mix(BLUE * 0.5, lit, used) + vec3(1.0) * (head * 0.8 + flash * 0.7);
      vA = (0.06 + 0.85 * used + 1.1 * head + 0.9 * flash) * (0.45 + 0.55 * fract(s2 * 13.1));
      size = (1.3 + 1.6 * fract(s * 7.7) + 2.4 * head) * uDpr;
    } else if (kind == 5) {
      // The dial's tick ring; the sweep runs once a minute and lights the ticks it passes.
      float th = 1.5707963 - s * TAU;
      bool major = mod(floor(s * 120.0 + 0.5), 10.0) < 0.5;
      p = vec2(cos(th), sin(th)) * (major ? 0.965 : 0.975);
      float lag = fract(uSweep - s);
      float glow = exp(-lag * 18.0);
      vC = mix(vec3(0.62, 0.71, 0.82), TEAL, glow);
      vA = (major ? 0.42 : 0.16) + 0.6 * glow;
      size = (major ? 3.0 : 1.7) * uDpr;
    } else {
      // The Runic mark: light running along a lemniscate.
      float t = TAU * fract(s + uTime * 0.035);
      float d = 1.0 + sin(t) * sin(t);
      vec2 q = vec2(cos(t), sin(t) * cos(t)) / d;
      vec2 tq = normalize(vec2(-sin(t), cos(2.0 * t)) + 1e-4);
      q += vec2(-tq.y, tq.x) * (s2 - 0.5) * 0.11;
      p = q * 0.19;
      vC = mix(TEAL, vec3(1.0), 0.25);
      vA = 0.22 * (0.4 + 0.6 * fract(s2 * 9.3));
      size = (0.9 + 1.2 * fract(s * 5.1)) * uDpr;
    }
    gl_Position = vec4(place(p), 0.0, 1.0);
    gl_PointSize = size;
  }`;

  const FRAG = `#version 300 es
  precision mediump float;
  in vec3 vC;
  in float vA;
  out vec4 o;
  void main() {
    float d = length(gl_PointCoord - 0.5);
    float a = vA * smoothstep(0.5, 0.05, d);
    o = vec4(vC * a, a);
  }`;

  // Five sample windows: how long each takes to fill, and where it starts.
  const PERIOD = [16, 23, 31, 44, 63];
  const PHASE = [0.86, 0.38, 0.62, 0.2, 0.47];

  function compile(gl: WebGL2RenderingContext, type: number, src: string) {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
    return s;
  }

  function start(hero: HTMLElement) {
    const canvas = hero.querySelector<HTMLCanvasElement>('.quota-canvas')!;
    const gl = canvas.getContext('webgl2', { antialias: false, premultipliedAlpha: true, alpha: true });
    if (!gl) return;
    const prog = gl.createProgram()!;
    try {
      gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    } catch {
      return;
    }
    gl.useProgram(prog);
    hero.classList.add('has-gl');

    const small = matchMedia('(max-width: 720px)').matches;
    const perRing = small ? 1100 : 2600;
    const TICKS = 120, MARK = small ? 700 : 1400;
    const n = RINGS * perRing + TICKS + MARK;
    const data = new Float32Array(n * 3);
    let k = 0;
    const put = (kind: number, a: number, b: number) => { data[k++] = kind; data[k++] = a; data[k++] = b; };
    for (let r = 0; r < RINGS; r++) for (let i = 0; i < perRing; i++) put(r, Math.random(), Math.random());
    for (let i = 0; i < TICKS; i++) put(5, i / TICKS, 0);
    for (let i = 0; i < MARK; i++) put(6, Math.random(), Math.random());

    const vao = gl.createVertexArray()!;
    gl.bindVertexArray(vao);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
    const aP = gl.getAttribLocation(prog, 'aP');
    gl.enableVertexAttribArray(aP);
    gl.vertexAttribPointer(aP, 3, gl.FLOAT, false, 0, 0);

    const u = (name: string) => gl.getUniformLocation(prog, name);
    const uTime = u('uTime'), uAspect = u('uAspect'), uDpr = u('uDpr'), uScale = u('uScale');
    const uSweep = u('uSweep'), uCenter = u('uCenter'), uFill = u('uFill'), uFlash = u('uFlash');
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE); // additive: dense arcs glow

    let dpr = 1;
    const resize = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
      gl.viewport(0, 0, w, h);
    };

    const fills = new Float32Array(RINGS), flashes = new Float32Array(RINGS);
    let time = 0;
    const draw = () => {
      resize();
      const aspect = canvas.width / canvas.height;
      // Wide: the dial sits on the right, clear of the copy. Narrow: centred
      // high, behind the copy, which the veil keeps readable.
      let scale: number, cx: number, cy: number;
      if (aspect > 1.15) {
        scale = Math.min(0.9, 0.46 * aspect);
        cx = Math.max(0.3, 1 - (scale / aspect) - 0.07);
        cy = 0;
      } else {
        scale = Math.min(0.62, 0.92 * aspect);
        cx = 0;
        cy = 1 - scale - 0.06;
      }
      for (let i = 0; i < RINGS; i++) {
        const f = PHASE[i] + time / PERIOD[i];
        fills[i] = f - Math.floor(f);
        const since = fills[i] * PERIOD[i]; // seconds since this window last reset
        flashes[i] = f >= 1 ? Math.exp(-since * 2.4) : 0;
      }
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(uTime, time);
      gl.uniform1f(uAspect, aspect);
      gl.uniform1f(uDpr, dpr);
      gl.uniform1f(uScale, scale);
      gl.uniform1f(uSweep, (time / 60) % 1);
      gl.uniform2f(uCenter, cx, cy);
      gl.uniform1fv(uFill, fills);
      gl.uniform1fv(uFlash, flashes);
      gl.drawArrays(gl.POINTS, 0, n);
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0, onScreen = true, speed = 1, target = 1, last = performance.now();
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      speed += (target - speed) * Math.min(1, dt * 2.5);
      time += dt * speed;
      draw();
      raf = requestAnimationFrame(frame);
    };
    const run = () => {
      cancelAnimationFrame(raf);
      if (still.matches) { time = 9; draw(); return; }
      if (onScreen && !document.hidden) { last = performance.now(); raf = requestAnimationFrame(frame); }
    };
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; run(); }).observe(hero);
    document.addEventListener('visibilitychange', run);
    still.addEventListener('change', run);
    window.addEventListener('resize', () => { if (still.matches) draw(); });
    hero.addEventListener('pointerenter', () => (target = 4));
    hero.addEventListener('pointerleave', () => (target = 1));
    run();
  }

  document.querySelectorAll<HTMLElement>('.quota-hero').forEach(start);
</script>
