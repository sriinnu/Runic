---
// A WebGL fragment-shader backdrop: domain-warped noise as an aurora, with
// concentric "quota gauge" arcs that breathe. The pointer pulls the field and
// lights it. Reusable across apps: pass two accent colours.
interface Props { accent?: string; accent2?: string; compact?: boolean }
const { accent = '#3ff0d6', accent2 = '#2d5bff', compact = false } = Astro.props;
---
<div class:list={['shader', { compact }]} data-accent={accent} data-accent2={accent2} data-compact={compact ? '1' : '0'}>
  <canvas aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>
  <div class="content"><slot /></div>
</div>

<style>
  .shader { position: relative; overflow: hidden; isolation: isolate; color: #eef3fb;
    background: radial-gradient(900px 500px at 30% 20%, color-mix(in srgb, var(--a) 22%, #070b12), #070b12 70%); }
  .shader { --a: #3ff0d6; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: -2; }
  .veil { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 90% at 50% 50%, rgba(7,11,18,.55), rgba(7,11,18,.15) 70%),
                linear-gradient(180deg, rgba(7,11,18,0) 60%, var(--bg, #070b12)); }
  .content { position: relative; max-width: 920px; margin: 0 auto; padding: 72px 24px 64px; text-align: center; }
  .compact .content { padding: 0; }
  .compact { height: 120px; border-bottom: 1px solid rgba(255,255,255,.08); }
  @media (prefers-reduced-motion: reduce) { .shader { background-attachment: scroll; } }
</style>

<script>
  const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FRAG = `
precision highp float;
uniform vec2 uRes; uniform float uTime; uniform vec2 uMouse; uniform vec3 uA; uniform vec3 uB; uniform float uRings; uniform float uLem; uniform float uLemAmt;
float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f);
  return mix(mix(hash(i),hash(i+vec2(1,0)),f.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x), f.y); }
float fbm(vec2 p){ float v=0., a=.5; mat2 m=mat2(1.6,1.2,-1.2,1.6);
  for(int i=0;i<5;i++){ v+=a*noise(p); p=m*p; a*=.5; } return v; }
void main(){
  float s=min(uRes.x,uRes.y);
  vec2 uv=(gl_FragCoord.xy-.5*uRes)/s;
  vec2 m=(uMouse-.5*uRes)/s;
  float t=uTime*.07;
  vec2 q=uv*1.25 + .30*m*exp(-dot(uv-m,uv-m)*3.0);
  vec2 w=vec2(fbm(q+vec2(0.,t)), fbm(q+vec2(5.2,1.3)-t));
  float f=fbm(q+2.1*w+vec2(t*.5));
  float r=length(uv);
  float ang=atan(uv.y,uv.x)/6.2831853+.5;
  float rings=0.;
  for(int i=0;i<4;i++){
    float fi=float(i);
    float rad=.30+fi*.14;
    float d=abs(r-rad-.015*sin(t*7.+fi*1.3+f*7.));
    float fill=.50+.42*sin(t*3.2+fi*1.9);
    float on=step(ang,fill);
    rings+=smoothstep(.0055,.0,d)*(.30+.70*on);
  }
  // The Runic mark: a lemniscate with a knot that travels along it.
  vec2 lp=uv*vec2(1.0,1.0)/(uLem);
  float x2=lp.x*lp.x, y2=lp.y*lp.y;
  float F=(x2+y2)*(x2+y2)-(x2-y2);
  vec2 g=vec2(4.*lp.x*(x2+y2)-2.*lp.x, 4.*lp.y*(x2+y2)+2.*lp.y);
  float dl=abs(F)/max(length(g),1e-3)*uLem;
  float lem=smoothstep(.016,.0,dl)+.35*smoothstep(.06,.0,dl);
  float ph=t*9.0;
  vec2 kn=vec2(cos(ph),sin(ph)*cos(ph))/(1.+sin(ph)*sin(ph))*uLem*1.0;
  float knot=exp(-dot(uv-kn,uv-kn)*900.);
  vec3 ink=vec3(.027,.043,.070);
  vec3 col=mix(ink,uB*.55,smoothstep(.22,.82,f));
  col+=uA*pow(smoothstep(.52,1.,f),2.)*.70;
  col+=mix(uA,uB,.35)*rings*uRings*(.45+f);
  col+=uA*.28*exp(-dot(uv-m,uv-m)*16.);
  col+=mix(uA,vec3(1.),.35)*lem*uLemAmt*(.55+.6*f);
  col+=vec3(1.)*knot*uLemAmt*1.1;
  col*=smoothstep(1.45,.15,r);
  col+=(hash(gl_FragCoord.xy+uTime)-.5)*.028;
  gl_FragColor=vec4(col,1.);
}`;

  const hex = (h: string): [number, number, number] => {
    const n = parseInt(h.replace('#', ''), 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  };

  document.querySelectorAll<HTMLElement>('.shader').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) return; // the CSS gradient behind the canvas is the fallback
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return gl.getShaderParameter(sh, gl.COMPILE_STATUS) ? sh : null;
    };
    const vs = compile(gl.VERTEX_SHADER, VERT), fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const U = (n: string) => gl.getUniformLocation(prog, n);
    const uLem = U('uLem'), uLemAmt = U('uLemAmt');
    const uRes = U('uRes'), uTime = U('uTime'), uMouse = U('uMouse'), uA = U('uA'), uB = U('uB'), uRings = U('uRings');
    gl.uniform3fv(uA, hex(root.dataset.accent || '#3ff0d6'));
    gl.uniform3fv(uB, hex(root.dataset.accent2 || '#2d5bff'));
    gl.uniform1f(uRings, root.dataset.compact === '1' ? 0.45 : 0.55);
    const compact = root.dataset.compact === '1';
    gl.uniform1f(uLemAmt, compact ? 0.0 : 1.0);
    gl.uniform1f(uLem, 0.42);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scale = Math.min(window.devicePixelRatio || 1, 1.5) * (root.dataset.compact === '1' ? 0.6 : 0.8);
    let mx = 0, my = 0, tx = 0, ty = 0, w = 1, h = 1, visible = true, raf = 0;
    const resize = () => {
      const r = root.getBoundingClientRect();
      w = Math.max(2, Math.floor(r.width * scale)); h = Math.max(2, Math.floor(r.height * scale));
      canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h);
      mx = tx = w / 2; my = ty = h / 2;
    };
    resize();
    addEventListener('resize', resize);
    root.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      tx = (e.clientX - r.left) * scale; ty = (r.bottom - e.clientY) * scale;
    });
    const start = performance.now();
    const frame = (now: number) => {
      mx += (tx - mx) * 0.06; my += (ty - my) * 0.06;
      gl.uniform2f(uRes, w, h);
      gl.uniform1f(uTime, reduce ? 6.0 : (now - start) / 1000);
      gl.uniform2f(uMouse, mx, my);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce && visible) raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
    }).observe(root);
    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); }
    });
    raf = requestAnimationFrame(frame);
  });
</script>
