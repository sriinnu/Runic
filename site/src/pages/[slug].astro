---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ParticleHero from '../components/ParticleHero.astro';

export function getStaticPaths() {
  const mods = import.meta.glob('../content/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(mods)
    .map(([file, mod]) => ({ slug: file.split('/').pop()!.replace(/\.md$/, ''), mod }))
    .filter(({ slug }) => slug !== 'home')
    .map(({ slug, mod }) => ({ params: { slug }, props: { mod } }));
}

const { slug } = Astro.params as { slug: string };
const { mod } = Astro.props as { mod: any };
const { Content, frontmatter } = mod;
const headings = (mod.getHeadings?.() ?? []).filter((h: any) => h.depth === 2);

const hues: Record<string, [string, string]> = {
  'themes-and-skins': ['#f2c94c', '#ff5160'], providers: ['#3ff0d6', '#4a63ff'], claude: ['#ff8a65', '#b388ff'],
  cli: ['#7bd88f', '#3ff0d6'], mcp: ['#b388ff', '#4a63ff'], architecture: ['#6f8cff', '#3ff0d6'],
  contributing: ['#ff6b81', '#f2c94c'], 'release-and-ops': ['#4fe3c1', '#6f8cff'],
};
const meta: Record<string, { group: string; label: string; summary: string }> = {
  'themes-and-skins': { group: 'Use', label: 'Themes and skins', summary: 'Thirteen themes drawn by seven kits. A theme is tokens; a skin recomposes every page.' },
  providers: { group: 'Use', label: 'Providers', summary: 'Where each provider’s numbers come from, in the order Runic tries them.' },
  claude: { group: 'Use', label: 'Claude', summary: 'OAuth, web and CLI sources, usage credits, banked resets and the monthly API credits on Max.' },
  cli: { group: 'Use', label: 'CLI', summary: 'The same usage, cost and quota numbers in a terminal, a script or CI.' },
  mcp: { group: 'Use', label: 'MCP', summary: 'A local, read-only MCP server so your agents can ask Runic about quota and credits.' },
  architecture: { group: 'Build', label: 'Architecture', summary: 'Modules, data flow, the usage ledger and how the menu is composed.' },
  contributing: { group: 'Build', label: 'Contributing', summary: 'Build, test, render a theme, add a provider or a skin.' },
  'release-and-ops': { group: 'Build', label: 'Release and ops', summary: 'How a release ships: gates, notarization, appcast, Homebrew.' },
};
const order = Object.keys(meta);
const i = order.indexOf(slug);
const prev = i > 0 ? order[i - 1] : null;
const next = i < order.length - 1 ? order[i + 1] : null;
const [a1, a2] = hues[slug] ?? hues.providers;
const me = meta[slug] ?? { group: 'Docs', label: frontmatter.title, summary: '' };
---
<Base title={frontmatter.title} path={`/${slug}/`} description={me.summary}>
  <ParticleHero compact accent={a1} accent2={a2}>
    <div class="doc-head">
      <p class="crumb"><a href="/">Runic</a> <span>/</span> {me.group}</p>
      <h1>{me.label}</h1>
      <p class="summary">{me.summary}</p>
    </div>
  </ParticleHero>

  <div class={`docs page-${slug}`} style={`--accent:${a1}`}>
    <aside class="side" aria-label="Documentation">
      {['Use', 'Build'].map((g) => (
        <div class="grp">
          <p>{g}</p>
          {order.filter((s) => meta[s].group === g).map((s) => (
            <a href={`/${s}/`} aria-current={s === slug ? 'page' : undefined}>{meta[s].label}</a>
          ))}
        </div>
      ))}
    </aside>

    <article class="prose">
      <Hero slug={slug} />
      <Content />
      <nav class="pager" aria-label="Previous and next">
        {prev ? <a class="prev" href={`/${prev}/`}><span>Previous</span>{meta[prev].label}</a> : <span></span>}
        {next ? <a class="next" href={`/${next}/`}><span>Next</span>{meta[next].label}</a> : <span></span>}
      </nav>
    </article>

    <aside class="toc" aria-label="On this page">
      <p>On this page</p>
      {headings.map((h: any) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </aside>
  </div>
</Base>

<script>
  // Scroll-spy for "On this page", and a copy button on every code block.
  // Runs on every client-side navigation, not just the first load.
  let spy: IntersectionObserver | null = null;
  document.addEventListener('astro:before-swap', () => { spy?.disconnect(); spy = null; });
  document.addEventListener('astro:page-load', () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const map = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    spy = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          links.forEach((l) => l.classList.remove('on'));
          map.get(en.target.id)?.classList.add('on');
        }
      });
    }, { rootMargin: '-72px 0px -70% 0px' });
    document.querySelectorAll('.prose h2[id]').forEach((h) => spy!.observe(h));

    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy')) return;
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'copy'; btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.innerText.replace(/\nCopy$/, '')); btn.textContent = 'Copied'; }
        catch { btn.textContent = 'Press ⌘C'; }
        setTimeout(() => (btn.textContent = 'Copy'), 1400);
      });
      pre.appendChild(btn);
    });
  });
</script>
