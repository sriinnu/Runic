---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" path="/404/" description="That page doesn’t exist.">
  <section class="lost">
    <div class="lost-dial" aria-hidden="true"><span>404</span></div>
    <p class="kicker">Window not found</p>
    <h1>This window never opened.</h1>
    <p class="sub">No page lives at this address. Try the <a href="/themes-and-skins/">skins</a>, the <a href="/providers/">providers</a>, the <a href="/cli/">CLI</a> or the <a href="/">home page</a>.</p>
    <div class="cta">
      <a class="btn primary" href="/">Back to Runic</a>
      <a class="btn ghost" href="https://github.com/sriinnu/Runic/issues">Report a broken link</a>
    </div>
  </section>
</Base>
