---
import Base from '../layouts/Base.astro';
import ParticleHero from '../components/ParticleHero.astro';
const themes = [
  ['theme-gazette.jpg', 'Gazette', 'A printed broadsheet', '#d4a72c'],
  ['theme-sumi.jpg', 'Sumi', 'Ink on washi', '#e0553a'],
  ['theme-drafting.jpg', 'Blueprint', 'An engineering sheet', '#7fd3ff'],
  ['theme-instrument.jpg', 'Retro', 'A bench instrument', '#d9633f'],
  ['theme-departures.jpg', 'Departures', 'A split-flap board', '#f2c94c'],
  ['theme-flightdeck.jpg', 'Flight deck', 'An avionics display', '#4fe3c1'],
  ['theme-receipt.jpg', 'Receipt', 'Every ping prints one', '#ff5160'],
];
const features = [
  ['01', 'Every provider', 'Codex, Claude, Gemini, Cursor, Copilot, DeepSeek, Kimi and more. Quota windows, banked resets, balances and spend, read the way each provider allows.', '/providers/'],
  ['02', 'Local first', 'Keys stay in your Keychain. History is built on your Mac from provider logs and an optional OTLP collector. Nothing leaves it except the provider’s own API call.', '/architecture/'],
  ['03', 'A CLI and an MCP server', 'The same numbers in a terminal or a script, and a read-only MCP server so Claude Code or Cursor can ask Runic about your quota.', '/cli/'],
  ['04', 'Skins, not palettes', 'Seven kits that change what the panel is: a broadsheet, a flight deck, a split-flap board, a receipt. Each one is a full composition.', '/themes-and-skins/'],
];
---
<Base path="/" fullBleed>
  <ParticleHero accent="#3ff0d6" accent2="#4a63ff">
    <div class="home-hero">
      <img class="icon" src="/runic-icon.png" width="84" height="84" alt="Runic icon" />
      <p class="eyebrow">macOS menu bar · open source</p>
      <h1>See every AI limit<br /><em>before it sees you.</em></h1>
      <p class="lede">Quota, reset windows, cost and token history across the tools you use, in one glance. Local first, with a skin for every mood.</p>
      <div class="cta">
        <a class="btn primary" href="https://github.com/sriinnu/Runic/releases/latest">Download for macOS</a>
        <a class="btn ghost" href="/themes-and-skins/">Explore the skins</a>
      </div>
      <pre class="install"><code>brew install --cask sriinnu/tap/runic</code></pre>
      <p class="stat-line"><span><b>13</b> themes</span><span><b>7</b> skins</span><span>local first</span></p>
    </div>
  </ParticleHero>

  <div class="wrap">
    <section class="stats" aria-label="At a glance">
      <div><b>13</b><span>themes</span></div>
      <div><b>7</b><span>full skins</span></div>
      <div><b>1</b><span>menu bar</span></div>
      <div><b>0</b><span>servers of ours</span></div>
    </section>

    <section class="features">
      {features.map(([n, t, d, href]) => (
        <a class="card" href={href}>
          <span class="n">{n}</span>
          <h3>{t}</h3>
          <p>{d}</p>
          <span class="more">Read more →</span>
        </a>
      ))}
    </section>

    <section class="gallery">
      <h2>Seven kits. One panel.</h2>
      <p class="sub">Not one look with seven palettes. Each skin recomposes every page.</p>
      <div class="deck">
        {themes.map(([img, name, line, color], i) => (
          <figure style={`--c:${color}; --i:${i}`}>
            <img src={`/images/${img}`} alt={`${name} skin`} loading="lazy" />
            <figcaption><b>{name}</b><span>{line}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="closer">
      <h2>Free, open, yours.</h2>
      <p>Runic is MIT-style open source. Read the notes, or just install it.</p>
      <div class="cta">
        <a class="btn primary" href="https://github.com/sriinnu/Runic/releases/latest">Download</a>
        <a class="btn ghost" href="https://github.com/sriinnu/Runic">Source on GitHub</a>
      </div>
    </section>
  </div>
</Base>
