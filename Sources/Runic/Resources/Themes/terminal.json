{
  "id": "terminal",
  "displayName": "Terminal",
  "tagline": "Amber phosphor",
  "symbolName": "terminal.fill",
  "isCustom": true,
  "prefersDarkAppearance": true,
  "colors": {
    "primary":       "#FFBC40",
    "secondary":     "#C99A52",
    "accent":        "#FFB000",
    "highlight":     "#FFC857",
    "warm":          "#FF6E4A",
    "tertiary":      "#D98A1F",
    "surface":       "#16100A",
    "surfaceAlt":    "#241A0E",
    "cardFill":      "#221811D9",
    "cardStroke":    "#E0A03066",
    "primaryText":   "#FFE9C2",
    "secondaryText": "#C9A978"
  },
  "fonts":   { "body": "mono", "numeric": "mono" },
  "shape":   { "cornerMultiplier": 0.45, "separator": "hairline" },
  "motion":  { "preset": "instant" },
  "density": { "preset": "normal" },
  "style": {
    "typography": { "bodyFamily": "Geist Mono", "numericFamily": "Geist Mono", "scale": 1.0, "tracking": 0.0, "lineSpacing": 1.2, "contrast": "strong" },
    "chrome": { "borderStyle": "hud", "borderWeight": 0.8, "borderOpacity": 0.46, "cornerStyle": "compact", "panelDepth": "low" },
    "effects": { "scanlineOpacity": 0.2, "glowStrength": 0.2, "materialIntensity": 0.0 },
    "controls": { "selectedFillStyle": "terminalSolid", "progressStyle": "segmentedHUD", "hoverStyle": "neutral" }
  }
}
