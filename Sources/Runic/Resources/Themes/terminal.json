{
  "id": "terminal",
  "displayName": "Terminal",
  "tagline": "Operator console",
  "symbolName": "terminal.fill",
  "isCustom": true,
  "prefersDarkAppearance": true,
  "colors": {
    "primary":       "#FFC94D",
    "secondary":     "#7DD3FC",
    "accent":        "#FFB000",
    "highlight":     "#FF8C42",
    "warm":          "#FF5C5C",
    "tertiary":      "#4CE0A0",
    "surface":       "#0B0B0D",
    "surfaceAlt":    "#141416E6",
    "cardFill":      "#FFFFFF0D",
    "cardStroke":    "#FFB00059",
    "primaryText":   "#F2EDE4",
    "secondaryText": "#B8B0A3"
  },
  "fonts":   { "body": "mono", "numeric": "mono" },
  "shape":   { "cornerMultiplier": 0.62, "separator": "hairline" },
  "motion":  { "preset": "instant" },
  "density": { "preset": "normal" },
  "style": {
    "typography": { "bodyFamily": "Geist Mono", "numericFamily": "Geist Mono", "scale": 1.0, "tracking": 0.0, "lineSpacing": 1.2, "contrast": "strong" },
    "chrome": { "borderStyle": "hud", "borderWeight": 0.75, "borderOpacity": 0.44, "cornerStyle": "compact", "panelDepth": "low" },
    "effects": { "scanlineOpacity": 0.08, "glowStrength": 0.12, "materialIntensity": 0.0 },
    "controls": { "selectedFillStyle": "terminalSolid", "progressStyle": "segmentedHUD", "hoverStyle": "neutral" }
  }
}
