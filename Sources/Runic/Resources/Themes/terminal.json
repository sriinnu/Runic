{
  "id": "terminal",
  "displayName": "Terminal",
  "tagline": "Cool slate, mint prompt",
  "symbolName": "terminal.fill",
  "isCustom": true,
  "prefersDarkAppearance": true,
  "colors": {
    "primary":       "#58E39A",
    "secondary":     "#7F8C99",
    "accent":        "#2FD37A",
    "highlight":     "#F2A33A",
    "warm":          "#FF5F57",
    "tertiary":      "#4EA1FF",
    "surface":       "#0B0F14",
    "surfaceAlt":    "#121820",
    "cardFill":      "#121820E6",
    "cardStroke":    "#263340E6",
    "primaryText":   "#D6DDE6",
    "secondaryText": "#B8C2CC"
  },
  "fonts":   { "body": "mono", "numeric": "mono" },
  "shape":   { "cornerMultiplier": 0.85, "separator": "hairline" },
  "motion":  { "preset": "instant" },
  "density": { "preset": "normal" },
  "style": {
    "typography": { "bodyFamily": "JetBrains Mono", "numericFamily": "JetBrains Mono", "scale": 1.0, "tracking": 0.0, "lineSpacing": 1.2, "contrast": "strong" },
    "chrome": { "borderStyle": "hairline", "borderWeight": 1.0, "borderOpacity": 0.55, "cornerStyle": "compact", "panelDepth": "low" },
    "effects": { "scanlineOpacity": 0.0, "glowStrength": 0.0, "materialIntensity": 0.0 },
    "controls": { "selectedFillStyle": "terminalSolid", "progressStyle": "flatBar", "hoverStyle": "neutral" }
  }
}
