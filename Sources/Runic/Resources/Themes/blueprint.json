    "effects": { "scanlineOpacity": 0.0, "glowStrength": 0.08, "materialIntensity": 0.0, "texture": "grid", "textureOpacity": 0.6 },
    "controls": { "selectedFillStyle": "accentSolid", "progressStyle": "flatBar", "hoverStyle": "neutral", "chartSeries": "themed" }
