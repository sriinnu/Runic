      "borderOpacity": 1.0,
      "cornerStyle": "sharp",
      "panelDepth": "flat"
    },
    "effects": { "scanlineOpacity": 0.0, "glowStrength": 0.0, "materialIntensity": 0.0 },
    "controls": {
      "selectedFillStyle": "accentSolid",
