    "accent":        "#0052CC|#52A8FF",
    "highlight":     "#9A4D00|#FFB340",
    "warm":          "#C42318|#FF6159",
    "tertiary":      "#09754E|#34D399",
    "surface":       "#EEF2F7|#0C1017",
    "surfaceAlt":    "#E3E9F1|#141B24",
    "cardFill":      "#FFFFFFC4|#1A222ECC",
    "cardStroke":    "#0B111A24|#FFFFFF2B",
    "primaryText":   "#0B111A|#F7F9FC",
    "secondaryText": "#344052|#A9B5C7"
