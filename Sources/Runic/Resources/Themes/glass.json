{
  "id": "glass",
  "displayName": "Glass",
  "tagline": "Optical liquid glass",
  "symbolName": "sparkle.magnifyingglass",
  "isCustom": true,
  "prefersDarkAppearance": null,
  "colors": {
    "primary":       "#0B111A|#F7F9FC",
